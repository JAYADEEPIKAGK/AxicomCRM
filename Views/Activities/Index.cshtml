@model IEnumerable<AcxiomCRM.Models.Activity>
@{ ViewData["Title"] = "Activities"; }
<div class="page-heading"><div><span class="eyebrow">CUSTOMER ENGAGEMENT</span><h1>Activities</h1><p>A shared timeline of calls, meetings, emails, and tasks.</p></div><a class="btn btn-primary" asp-action="Create">+ Log activity</a></div><div class="panel-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Type</th><th>Subject</th><th>Related to</th><th>Details</th><th>Date</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><span class="status-pill">@item.Type</span></td><td class="fw-semibold">@item.Subject</td><td>@(item.Customer?.Name ?? item.Lead?.Name ?? item.Opportunity?.Name ?? "—")</td><td>@item.Details</td><td>@item.OccurredAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td></tr> }@if (!Model.Any()) { <tr><td colspan="5" class="empty-state">No activities logged yet.</td></tr> }</tbody></table></div></div>
