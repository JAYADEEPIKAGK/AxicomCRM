@model IEnumerable<AcxiomCRM.Models.ApplicationUser>
@inject Microsoft.AspNetCore.Identity.UserManager<AcxiomCRM.Models.ApplicationUser> UserManager
@{ ViewData["Title"] = "Users & roles"; }
<div class="page-heading"><div><span class="eyebrow">ADMINISTRATION</span><h1>Users &amp; roles</h1><p>Manage workspace access and permissions.</p></div><a class="btn btn-primary" asp-action="Create">+ Create user</a></div>
<div class="panel-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>User</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Model) { var roles = await UserManager.GetRolesAsync(item); <tr><td class="fw-semibold">@item.FullName</td><td>@item.Email</td><td>@(roles.FirstOrDefault() ?? "No role")</td><td><span class="status-pill @(item.IsActive ? "" : "status-warning")">@(item.IsActive ? "Active" : "Inactive")</span></td><td class="text-end"><a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="SetActive" asp-route-id="@item.Id" method="post" class="d-inline"><input type="hidden" name="active" value="@(!item.IsActive)" /><button class="btn btn-sm btn-outline-@(item.IsActive ? "danger" : "success") ms-1" @(item.Id == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ? "disabled" : "")>@(item.IsActive ? "Deactivate" : "Activate")</button></form></td></tr> }@if (!Model.Any()) { <tr><td colspan="5" class="empty-state">No users found.</td></tr> }</tbody></table></div></div>
