@model AcxiomCRM.Controllers.UserAdminInput
@{ ViewData["Title"] = "Edit user"; }
<div class="page-heading"><div><span class="eyebrow">USERS &amp; ROLES</span><h1>Edit user</h1><p>Update account details, access level, and status.</p></div><a class="btn btn-light" asp-action="Index">Back to users</a></div>
<div class="panel-card form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <partial name="_UserFields" model="Model" />
        <div class="form-check mt-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Account active</label><span asp-validation-for="IsActive" class="text-danger"></span></div>
        <div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-primary">Save changes</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
