@model AcxiomCRM.Controllers.UserAdminInput
@{ ViewData["Title"] = "Create user"; }
<div class="page-heading"><div><span class="eyebrow">USERS &amp; ROLES</span><h1>Create user</h1><p>Add a user to your CRM workspace.</p></div><a class="btn btn-light" asp-action="Index">Back to users</a></div>
<div class="panel-card form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <partial name="_UserFields" model="Model" />
        <div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-primary">Create user</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
