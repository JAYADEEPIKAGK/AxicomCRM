@model AcxiomCRM.Controllers.UserAdminInput
<div class="row g-3">
    <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" type="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option>Sales Executive</option><option>Manager</option><option>Admin</option></select><span asp-validation-for="Role" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="ManagerUserId" class="form-label">Reporting manager (optional)</label><select asp-for="ManagerUserId" class="form-select"><option value="">No manager</option>@foreach (var manager in (IEnumerable<AcxiomCRM.Models.ApplicationUser>)ViewBag.Managers) { <option value="@manager.Id">@manager.FullName</option> }</select><span asp-validation-for="ManagerUserId" class="text-danger"></span></div>
    @if (ViewContext.RouteData.Values["action"]?.ToString() == "Create")
    {
        <div class="col-md-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span><small class="form-text">At least 8 characters with uppercase, lowercase, number, and symbol.</small></div>
    }
</div>
