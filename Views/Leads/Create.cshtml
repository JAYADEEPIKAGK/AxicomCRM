@model AcxiomCRM.Models.Lead
@{ ViewData["Title"] = "Add lead"; }
<div class="page-heading"><div><span class="eyebrow">LEADS</span><h1>Add lead</h1><p>Add a prospect to your pipeline.</p></div><a class="btn btn-light" asp-action="Index">Back to leads</a></div>
<div class="panel-card form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <partial name="_LeadFields" model="Model" />
        <div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-primary">Save lead</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
