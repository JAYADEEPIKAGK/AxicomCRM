@model AcxiomCRM.Models.Lead
@{ ViewData["Title"] = "Lead details"; }
<div class="page-heading"><div><span class="eyebrow">LEAD PROFILE</span><h1>@Model.Name</h1><p>@Model.Company</p></div><div><a class="btn btn-light" asp-action="Edit" asp-route-id="@Model.Id">Edit lead</a><a class="btn btn-primary" asp-controller="FollowUps" asp-action="Create">Schedule follow-up</a></div></div><div class="panel-card"><div class="row g-4"><div class="col-md-6"><dl class="detail-list"><dt>Status</dt><dd><span class="status-pill">@Model.Status</span></dd><dt>Email</dt><dd>@(Model.Email ?? "—")</dd><dt>Phone</dt><dd>@(Model.Phone ?? "—")</dd><dt>Company</dt><dd>@(Model.Company ?? "—")</dd></dl></div><div class="col-md-6"><h2>Notes</h2><p>@(Model.Notes ?? "No notes recorded.")</p>@if (Model.Customer is not null) { <p>Converted customer: <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer.Name</a></p> }</div></div></div>
