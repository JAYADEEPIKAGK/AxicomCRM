@model IEnumerable<AcxiomCRM.Models.Lead>
@{ ViewData["Title"] = "Leads"; }
<div class="page-heading"><div><span class="eyebrow">SALES PROSPECTS</span><h1>Leads</h1><p>Manage prospects from first contact through conversion.</p></div><a class="btn btn-primary" asp-action="Create">+ Add lead</a></div>
<div class="panel-card"><form method="get" class="filter-row mb-3"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search leads" /><select name="status" class="form-select"><option value="">All statuses</option>@foreach (var status in AcxiomCRM.Models.LeadStatuses.All) { <option value="@status" selected="@((ViewBag.Status as string) == status)">@status</option> }</select><button class="btn btn-outline-primary">Filter</button></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Lead</th><th>Company</th><th>Contact</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><a class="fw-semibold" asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td><td>@item.Company</td><td>@item.Email<br /><small>@item.Phone</small></td><td><span class="status-pill">@item.Status</span></td><td class="text-end"><a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@item.Id">Edit</a>@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a class="btn btn-sm btn-light ms-1" asp-action="Assign" asp-route-id="@item.Id">Assign</a> }@if (item.Status != AcxiomCRM.Models.LeadStatuses.Converted && item.Status != AcxiomCRM.Models.LeadStatuses.Lost) { <form asp-action="Convert" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Convert this lead into a customer?')"><button class="btn btn-sm btn-outline-success ms-1">Convert</button></form> }<form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Deactivate this lead?')"><button class="btn btn-sm btn-outline-danger ms-1">Deactivate</button></form></td></tr> }@if (!Model.Any()) { <tr><td colspan="5" class="empty-state">No leads match your filters.</td></tr> }</tbody></table></div><nav aria-label="Lead pages"><ul class="pagination pagination-sm justify-content-end">@for (var p = 1; p <= (int)ViewBag.TotalPages; p++) { <li class="page-item @(p == (int)ViewBag.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status">@p</a></li> }</ul></nav>
</div>
