@model AcxiomCRM.Models.Lead
@{ ViewData["Title"] = "Edit lead"; }
<div class="page-heading"><div><span class="eyebrow">LEADS</span><h1>Edit lead</h1><p>Update prospect information and status.</p></div><a class="btn btn-light" asp-action="Index">Back to leads</a></div>
<div class="panel-card form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <partial name="_LeadFields" model="Model" />
        <div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-primary">Save changes</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
