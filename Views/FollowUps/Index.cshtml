@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{ ViewData["Title"] = "Follow-ups"; }
<div class="page-heading"><div><span class="eyebrow">CUSTOMER TOUCHPOINTS</span><h1>Follow-ups</h1><p>Stay on top of calls, meetings, and next steps.</p></div><a class="btn btn-primary" asp-action="Create">+ Schedule follow-up</a></div>
<div class="panel-card"><div class="btn-group mb-3"><a class="btn btn-sm @(ViewBag.View == "pending" ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-view="pending">Pending</a><a class="btn btn-sm @(ViewBag.View == "missed" ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-view="missed">Missed</a></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Follow-up</th><th>Related to</th><th>Due</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td class="fw-semibold">@item.Subject</td><td>@(item.Customer?.Name ?? item.Lead?.Name ?? "—")</td><td>@item.DueAt.ToString("MMM d, yyyy h:mm tt")</td><td><span class="status-pill @(item.DueAt < DateTime.Now ? "status-warning" : "")">@(item.DueAt < DateTime.Now ? "Missed" : "Pending")</span></td><td class="text-end"><form asp-action="Complete" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-success">Complete</button></form><button class="btn btn-sm btn-light ms-1" data-bs-toggle="collapse" data-bs-target="#reschedule-@item.Id">Reschedule</button><form id="reschedule-@item.Id" asp-action="Reschedule" asp-route-id="@item.Id" method="post" class="collapse mt-2"><input name="dueAt" type="datetime-local" class="form-control form-control-sm d-inline-block" style="max-width:210px" required min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" /><button class="btn btn-sm btn-primary ms-1">Save</button></form></td></tr> }@if (!Model.Any()) { <tr><td colspan="5" class="empty-state">No follow-ups in this view.</td></tr> }</tbody></table></div></div>
