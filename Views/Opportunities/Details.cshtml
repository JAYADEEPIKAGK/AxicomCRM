@model AcxiomCRM.Models.Opportunity
@{ ViewData["Title"] = "Opportunity details"; }
<div class="page-heading"><div><span class="eyebrow">OPPORTUNITY</span><h1>@Model.Name</h1><p>@(Model.Customer?.Name ?? Model.Lead?.Name ?? "No associated customer or lead")</p></div><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit opportunity</a></div><div class="panel-card"><div class="row g-4"><div class="col-md-6"><dl class="detail-list"><dt>Stage</dt><dd><span class="status-pill">@Model.Stage</span></dd><dt>Amount</dt><dd>@Model.Amount.ToString("C")</dd><dt>Probability</dt><dd>@Model.Probability%</dd><dt>Expected close</dt><dd>@Model.ExpectedCloseDate.ToString("MMMM d, yyyy")</dd></dl></div><div class="col-md-6"><h2>Weighted forecast</h2><p class="display-6 text-primary">@((Model.Amount * Model.Probability / 100m).ToString("C"))</p><p class="text-secondary">Calculated from the opportunity amount and probability.</p></div></div></div>
