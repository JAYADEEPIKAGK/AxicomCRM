@model AcxiomCRM.Models.Opportunity
<div class="row g-3">
    <div class="col-12"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" /><span asp-validation-for="Amount" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Probability" class="form-label"></label><div class="input-group"><input asp-for="Probability" class="form-control" type="number" min="0" max="100" /><span class="input-group-text">%</span></div><span asp-validation-for="Probability" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" class="form-select">@foreach (var stage in AcxiomCRM.Models.OpportunityStages.All) { <option value="@stage">@stage</option> }</select><span asp-validation-for="Stage" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" class="form-control" type="date" /><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="CustomerId" class="form-label">Customer (optional)</label><select asp-for="CustomerId" class="form-select"><option value="">No customer selected</option>@foreach (var customer in (IEnumerable<AcxiomCRM.Models.Customer>)ViewBag.Customers) { <option value="@customer.Id">@customer.Name</option> }</select><span asp-validation-for="CustomerId" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="LeadId" class="form-label">Lead (optional)</label><select asp-for="LeadId" class="form-select"><option value="">No lead selected</option>@foreach (var lead in (IEnumerable<AcxiomCRM.Models.Lead>)ViewBag.Leads) { <option value="@lead.Id">@lead.Name</option> }</select><span asp-validation-for="LeadId" class="text-danger"></span></div>
</div>
