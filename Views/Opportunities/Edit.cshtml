@model AcxiomCRM.Models.Opportunity
@{ ViewData["Title"] = "Edit opportunity"; }
<div class="page-heading"><div><span class="eyebrow">OPPORTUNITIES</span><h1>Edit opportunity</h1><p>Update deal value, stage, or close date.</p></div><a class="btn btn-light" asp-action="Index">Back to opportunities</a></div>
<div class="panel-card form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <partial name="_OpportunityFields" model="Model" />
        <div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-primary">Save changes</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
