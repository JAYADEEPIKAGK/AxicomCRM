@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{ ViewData["Title"] = "Opportunities"; }
<div class="page-heading"><div><span class="eyebrow">REVENUE PIPELINE</span><h1>Opportunities</h1><p>Prioritize deals and forecast your sales.</p></div><a class="btn btn-primary" asp-action="Create">+ New opportunity</a></div>
<div class="panel-card"><form method="get" class="filter-row mb-3"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search opportunity or customer" /><select name="stage" class="form-select"><option value="">All stages</option>@foreach (var stage in AcxiomCRM.Models.OpportunityStages.All) { <option value="@stage" selected="@((ViewBag.Stage as string) == stage)">@stage</option> }</select><button class="btn btn-outline-primary">Filter</button></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Opportunity</th><th>Customer</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Expected close</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><a class="fw-semibold" asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td><td>@(item.Customer?.Name ?? "—")</td><td><span class="status-pill">@item.Stage</span></td><td>@item.Amount.ToString("C")</td><td>@item.Probability%</td><td>@item.ExpectedCloseDate.ToString("MMM d, yyyy")</td><td class="text-end"><a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Deactivate this opportunity?')"><button class="btn btn-sm btn-outline-danger ms-1">Deactivate</button></form></td></tr> }@if (!Model.Any()) { <tr><td colspan="7" class="empty-state">No opportunities match your filters.</td></tr> }</tbody></table></div></div>
