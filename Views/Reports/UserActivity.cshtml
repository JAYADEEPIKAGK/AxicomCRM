@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{ ViewData["Title"] = "User activity report"; }
<div class="page-heading"><div><span class="eyebrow">REPORTS</span><h1>User activity</h1><p>Recent actions by users in your accessible team.</p></div><a class="btn btn-light" asp-action="Index">All reports</a></div>
<div class="panel-card"><div class="table-responsive"><table class="table"><thead><tr><th>When</th><th>User</th><th>Activity</th><th>Record</th><th>Details</th></tr></thead><tbody>@foreach (var row in Model) { <tr><td>@row.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td><td>@(row.UserName ?? "Anonymous")</td><td>@row.Action</td><td>@row.EntityType @row.EntityId</td><td>@row.Details</td></tr> }@if (!Model.Any()) { <tr><td colspan="5" class="empty-state">No user activity found.</td></tr> }</tbody></table></div></div>
