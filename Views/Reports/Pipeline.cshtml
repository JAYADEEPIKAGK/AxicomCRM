@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{ ViewData["Title"] = "Sales pipeline report"; var total = Model.Sum(x => x.Amount); var weighted = Model.Sum(x => x.Amount * x.Probability / 100m); }
<div class="page-heading"><div><span class="eyebrow">REPORTS</span><h1>Sales pipeline</h1><p>Open opportunity value and weighted forecast.</p></div><a class="btn btn-light" asp-action="Index">All reports</a></div>
<div class="row g-3 mb-3"><div class="col-md-6"><div class="metric-card"><span>Open pipeline</span><strong>@total.ToString("C")</strong><small>Active open opportunity value</small></div></div><div class="col-md-6"><div class="metric-card"><span>Weighted forecast</span><strong>@weighted.ToString("C")</strong><small>Amount adjusted by probability</small></div></div></div>
<div class="panel-card"><div class="table-responsive"><table class="table"><thead><tr><th>Opportunity</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Weighted amount</th><th>Close date</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Name</td><td>@item.Stage</td><td>@item.Amount.ToString("C")</td><td>@item.Probability%</td><td>@((item.Amount * item.Probability / 100m).ToString("C"))</td><td>@item.ExpectedCloseDate.ToString("MMM d, yyyy")</td></tr> }@if (!Model.Any()) { <tr><td colspan="6" class="empty-state">No open opportunities in the pipeline.</td></tr> }</tbody></table></div></div>
