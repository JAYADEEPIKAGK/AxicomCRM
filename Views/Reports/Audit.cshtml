@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{ ViewData["Title"] = "Audit log"; }
<div class="page-heading"><div><span class="eyebrow">ADMINISTRATION</span><h1>Audit log</h1><p>Recent authentication and record activity.</p></div></div><div class="panel-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Timestamp</th><th>User</th><th>Action</th><th>Record</th><th>Details</th></tr></thead><tbody>@foreach (var row in Model) { <tr><td>@row.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm:ss tt")</td><td>@(row.UserName ?? "Anonymous")</td><td><span class="status-pill">@row.Action</span></td><td>@row.EntityType @row.EntityId</td><td>@row.Details</td></tr> }@if (!Model.Any()) { <tr><td colspan="5" class="empty-state">No audit activity recorded.</td></tr> }</tbody></table></div></div>
