@{ ViewData["Title"] = "Reports"; }
<div class="page-heading"><div><span class="eyebrow">INSIGHTS</span><h1>Reports</h1><p>Review your customer base, conversion activity, and sales pipeline.</p></div></div>
<div class="row g-3 mb-3"><div class="col-md-4"><div class="metric-card"><span>Active customers</span><strong>@ViewBag.Customers</strong><small>In your accessible portfolio</small></div></div><div class="col-md-4"><div class="metric-card"><span>Follow-ups</span><strong>@ViewBag.FollowUps</strong><small>Scheduled and completed</small></div></div><div class="col-md-4"><div class="metric-card"><span>Activities</span><strong>@ViewBag.Activities</strong><small>Logged interactions</small></div></div></div>
<div class="row g-3"><div class="col-lg-5"><div class="panel-card"><h2>Lead report</h2><p class="panel-subtitle">Active leads by status</p><div class="table-responsive"><table class="table"><thead><tr><th>Status</th><th class="text-end">Count</th></tr></thead><tbody>@foreach (var row in ViewBag.Leads) { <tr><td>@row.Name</td><td class="text-end fw-semibold">@row.Count</td></tr> }@if (ViewBag.Leads.Count == 0) { <tr><td colspan="2" class="empty-state">No lead data yet.</td></tr> }</tbody></table></div></div></div><div class="col-lg-7"><div class="panel-card"><h2>Opportunity pipeline report</h2><p class="panel-subtitle">Active opportunities by stage</p><div class="table-responsive"><table class="table"><thead><tr><th>Stage</th><th class="text-end">Deals</th><th class="text-end">Amount</th></tr></thead><tbody>@foreach (var row in ViewBag.Opportunities) { <tr><td>@row.Name</td><td class="text-end">@row.Count</td><td class="text-end fw-semibold">@((decimal)row.Value).ToString("C")</td></tr> }@if (ViewBag.Opportunities.Count == 0) { <tr><td colspan="3" class="empty-state">No opportunity data yet.</td></tr> }</tbody></table></div></div></div></div>
@if (User.IsInRole("Admin")) { <div class="mt-3"><a class="btn btn-outline-primary" asp-action="Audit">Review audit log</a></div> }
<div class="row g-2 mt-3">
    <div class="col-6 col-md-3"><a class="panel-card report-link d-block" asp-action="Customers">Customer report <span>→</span></a></div>
    <div class="col-6 col-md-3"><a class="panel-card report-link d-block" asp-action="Leads">Lead report <span>→</span></a></div>
    <div class="col-6 col-md-3"><a class="panel-card report-link d-block" asp-action="FollowUps">Follow-up report <span>→</span></a></div>
    <div class="col-6 col-md-3"><a class="panel-card report-link d-block" asp-action="Opportunities">Opportunity report <span>→</span></a></div>
    <div class="col-6 col-md-3"><a class="panel-card report-link d-block" asp-action="Pipeline">Sales pipeline <span>→</span></a></div>
    <div class="col-6 col-md-3"><a class="panel-card report-link d-block" asp-action="Conversion">Conversion report <span>→</span></a></div>
    <div class="col-6 col-md-3"><a class="panel-card report-link d-block" asp-action="UserActivity">User activity <span>→</span></a></div>
</div>
