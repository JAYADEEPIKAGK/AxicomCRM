@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{ ViewData["Title"] = "Follow-up report"; }
<div class="page-heading"><div><span class="eyebrow">REPORTS</span><h1>Follow-up report</h1><p>Scheduled, overdue, and completed follow-ups.</p></div><a class="btn btn-light" asp-action="Index">All reports</a></div>
<div class="panel-card"><div class="table-responsive"><table class="table"><thead><tr><th>Subject</th><th>Related to</th><th>Due</th><th>Status</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Subject</td><td>@(item.Customer?.Name ?? item.Lead?.Name ?? "—")</td><td>@item.DueAt.ToString("MMM d, yyyy h:mm tt")</td><td><span class="status-pill @(item.CompletedAtUtc is not null ? "" : item.DueAt < DateTime.Now ? "status-warning" : "")">@(item.CompletedAtUtc is not null ? "Completed" : item.DueAt < DateTime.Now ? "Missed" : "Pending")</span></td></tr> }@if (!Model.Any()) { <tr><td colspan="4" class="empty-state">No follow-ups found.</td></tr> }</tbody></table></div></div>
