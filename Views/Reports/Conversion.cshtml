@model AcxiomCRM.Controllers.ReportsController.ConversionReportViewModel
@{ ViewData["Title"] = "Conversion report"; }
<div class="page-heading"><div><span class="eyebrow">REPORTS</span><h1>Conversion report</h1><p>Measure lead progression and conversion.</p></div><a class="btn btn-light" asp-action="Index">All reports</a></div>
<div class="row g-3 mb-3"><div class="col-md-4"><div class="metric-card"><span>Total leads</span><strong>@Model.TotalLeads</strong><small>Active portfolio</small></div></div><div class="col-md-4"><div class="metric-card"><span>Converted leads</span><strong>@Model.ConvertedLeads</strong><small>Leads linked to customers</small></div></div><div class="col-md-4"><div class="metric-card"><span>Conversion rate</span><strong>@Model.ConversionRate.ToString("0.0")%</strong><small>Converted leads / active leads</small></div></div></div>
<div class="panel-card"><h2>Lead status breakdown</h2><table class="table"><thead><tr><th>Status</th><th class="text-end">Leads</th></tr></thead><tbody>@foreach (var item in Model.ByStatus) { <tr><td>@item.Status</td><td class="text-end">@item.Count</td></tr> }@if (Model.ByStatus.Count == 0) { <tr><td colspan="2" class="empty-state">No lead data found.</td></tr> }</tbody></table></div>
