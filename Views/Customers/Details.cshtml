@model AcxiomCRM.Models.Customer
@{ ViewData["Title"] = "Customer details"; }
<div class="page-heading"><div><span class="eyebrow">CUSTOMER PROFILE</span><h1>@Model.Name</h1><p>@Model.Company</p></div><div><a class="btn btn-outline-primary" asp-action="History" asp-route-id="@Model.Id">View history</a><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit customer</a></div></div>
<div class="row g-3"><div class="col-lg-5"><div class="panel-card"><h2>Contact information</h2><dl class="detail-list"><dt>Email</dt><dd>@(Model.Email ?? "—")</dd><dt>Phone</dt><dd>@(Model.Phone ?? "—")</dd><dt>Address</dt><dd>@(Model.Address ?? "—")</dd><dt>Created</dt><dd>@Model.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</dd></dl></div></div><div class="col-lg-7"><div class="panel-card"><h2>Associated leads</h2>@if (!Model.Leads.Any()) { <div class="empty-state">No leads associated with this customer.</div> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Status</th></tr></thead><tbody>@foreach (var lead in Model.Leads) { <tr><td><a asp-controller="Leads" asp-action="Details" asp-route-id="@lead.Id">@lead.Name</a></td><td><span class="status-pill">@lead.Status</span></td></tr> }</tbody></table></div> }</div></div></div>
